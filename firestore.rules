rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return logado() && request.auth.token.email in ['filmbourbon@gmail.com']; }

    // projetos: o cliente lê só os próprios; só a equipe escreve
    match /projetos/{id} {
      allow read: if isAdmin() || (logado() && resource.data.clienteEmail == request.auth.token.email.lower());
      allow write: if isAdmin();
    }
    // clientes da casa: só a equipe
    match /clientes/{id} {
      allow read, write: if isAdmin();
    }
    // perfil de quem cria conta: cada um cuida do próprio; a equipe consulta
    match /usuarios/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'criadoEm']);
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
